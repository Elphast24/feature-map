{
  "name": "sbatlas",
  "displayName": "SBAtlas",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.123.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:sbatlas.helloWorld"
  ],
  "main": "./dist/extension.js",
  "contributes": {
     "configuration": {
      "title": "SBAtlas",
      "properties": {
        "sbatlas.googleApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your Google AI Studio API key. Get one free at https://aistudio.google.com/apikey",
          "order": 1
        },
        "sbatlas.googleModel": {
          "type": "string",
          "default": "gemini-2.0-flash",
          "markdownDescription": "The Gemini model to use. Run `SBAtlas: Select AI Model` to see available models.",
          "order": 2
        },
        "sbatlas.maxTokens": {
          "type": "number",
          "default": 4096,
          "markdownDescription": "Maximum tokens in the AI response.",
          "order": 3
        }
      }
    },
     "commands": [
      { "command": "sbatlas.createProject", "title": "Create Project", "category": "SBAtlas" },
      { "command": "sbatlas.deleteProject", "title": "Delete Project", "category": "SBAtlas" },
      { "command": "sbatlas.switchProject", "title": "Switch Project", "category": "SBAtlas" },
      { "command": "sbatlas.listProjects", "title": "List Projects", "category": "SBAtlas" },
      { "command": "sbatlas.pasteRequirement", "title": "Add Requirement", "category": "SBAtlas" },
      { "command": "sbatlas.editRequirement", "title": "Edit Requirement", "category": "SBAtlas" },
      { "command": "sbatlas.refresh", "title": "Refresh", "category": "SBAtlas" },
      { "command": "sbatlas.generateRoadmap", "title": "Generate Roadmap", "category": "SBAtlas" },
      { "command": "sbatlas.deleteRoadmap", "title": "Delete Roadmap", "category": "SBAtlas" },
      { "command": "sbatlas.updateTaskStatus", "title": "Update Task Status", "category": "SBAtlas" },
      { "command": "sbatlas.addTaskNote", "title": "Add Task Note", "category": "SBAtlas" },
      { "command": "sbatlas.addTask", "title": "Add Task", "category": "SBAtlas" },
      { "command": "sbatlas.removeTask", "title": "Remove Task", "category": "SBAtlas" },
      { "command": "sbatlas.nextTask", "title": "Next Task", "category": "SBAtlas" },
      { "command": "sbatlas.showProgress", "title": "Show Progress", "category": "SBAtlas" },
      { "command": "sbatlas.showCoverage", "title": "Show Coverage", "category": "SBAtlas" },
      { "command": "sbatlas.selectModel", "title": "Select AI Model", "category": "SBAtlas" },
       { "command": "sbatlas.importRequirements", "title": "Import Requirements from File", "category": "SBAtlas" },
      { "command": "sbatlas.bulkAddRequirements", "title": "Bulk Add Requirements", "category": "SBAtlas" },
      { "command": "sbatlas.setRequirementPriority", "title": "Set Requirement Priority", "category": "SBAtlas" },
      { "command": "sbatlas.tagRequirement", "title": "Tag Requirement", "category": "SBAtlas" },
      { "command": "sbatlas.confirmBulkAdd", "title": "Confirm Bulk Add", "category": "SBAtlas" },
      { "command": "sbatlas.moveTaskUp", "title": "Move Task Up", "category": "SBAtlas" },
      { "command": "sbatlas.moveTaskDown", "title": "Move Task Down", "category": "SBAtlas" },
      { "command": "sbatlas.moveTaskToModule", "title": "Move Task to Module", "category": "SBAtlas" },
      { "command": "sbatlas.batchUpdateTasks", "title": "Batch Update Tasks", "category": "SBAtlas" },
      { "command": "sbatlas.manageTaskDependencies", "title": "Manage Task Dependencies", "category": "SBAtlas" },
      { "command": "sbatlas.search", "title": "Search", "category": "SBAtlas" },
      { "command": "sbatlas.filter", "title": "Filter", "category": "SBAtlas" },
      { "command": "sbatlas.clearFilters", "title": "Clear Filters", "category": "SBAtlas" },
      { "command": "sbatlas.export", "title": "Export", "category": "SBAtlas" },
      { "command": "sbatlas.copyProgress", "title": "Copy Progress to Clipboard", "category": "SBAtlas" },
       { "command": "sbatlas.generateReport", "title": "Generate Project Report", "category": "SBAtlas" }

    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sbatlas-sidebar",
          "title": "SBAtlas",
          "icon": "resources/icons/sbatlas.svg"
        }
      ]
    },
    "views": {
      "sbatlas-sidebar": [
        {
          "id": "sbatlasProjectView",
          "name": "Project",
          "icon": "resources/icons/sbatlas.svg",
          "contextualTitle": "SBAtlas"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sbatlas.createProject",
          "when": "view == sbatlasProjectView",
          "group": "navigation"
        },
        {
          "command": "sbatlas.refresh",
          "when": "view == sbatlasProjectView",
          "group": "navigation"
        },
        {
          "command": "sbatlas.search",
          "when": "view == sbatlasProjectView",
          "group": "navigation"
        },
        {
          "command": "sbatlas.filter",
          "when": "view == sbatlasProjectView",
          "group": "navigation"
        },
         {
          "command": "sbatlas.generateReport",
          "when": "view == sbatlasProjectView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "sbatlas.pasteRequirement",
          "when": "view == sbatlasProjectView && viewItem == requirementsSection",
          "group": "inline"
        },
        {
          "command": "sbatlas.editRequirement",
          "when": "view == sbatlasProjectView && viewItem == requirementItem",
          "group": "inline"
        },
        {
          "command": "sbatlas.deleteProject",
          "when": "view == sbatlasProjectView && viewItem == projectRoot",
          "group": "9_delete"
        },
        {
          "command": "sbatlas.generateRoadmap",
          "when": "view == sbatlasProjectView && viewItem == roadmapSection",
          "group": "1_generate"
        },
        {
          "command": "sbatlas.deleteRoadmap",
          "when": "view == sbatlasProjectView && viewItem == roadmapSection",
          "group": "9_delete"
        },
        {
          "command": "sbatlas.showProgress",
          "when": "view == sbatlasProjectView && viewItem == roadmapSection",
          "group": "2_reports"
        },
        {
          "command": "sbatlas.showCoverage",
          "when": "view == sbatlasProjectView && viewItem == roadmapSection",
          "group": "2_reports"
        },
        {
          "command": "sbatlas.addTask",
          "when": "view == sbatlasProjectView && viewItem == moduleItem",
          "group": "inline"
        },
        {
          "command": "sbatlas.updateTaskStatus",
          "when": "view == sbatlasProjectView && viewItem == taskItem",
          "group": "1_status"
        },
        {
          "command": "sbatlas.addTaskNote",
          "when": "view == sbatlasProjectView && viewItem == taskItem",
          "group": "2_notes"
        },
        {
          "command": "sbatlas.removeTask",
          "when": "view == sbatlasProjectView && viewItem == taskItem",
          "group": "9_delete"
        },
        {
          "command": "sbatlas.setRequirementPriority",
          "when": "view == sbatlasProjectView && viewItem == requirementItem",
          "group": "2_priority"
        },
        {
          "command": "sbatlas.tagRequirement",
          "when": "view == sbatlasProjectView && viewItem == requirementItem",
          "group": "3_tags"
        },
        {
          "command": "sbatlas.importRequirements",
          "when": "view == sbatlasProjectView && viewItem == requirementsSection",
          "group": "2_import"
        },
        {
          "command": "sbatlas.bulkAddRequirements",
          "when": "view == sbatlasProjectView && viewItem == requirementsSection",
          "group": "2_import"
        },
        {
          "command": "sbatlas.moveTaskUp",
          "when": "view == sbatlasProjectView && viewItem == taskItem",
          "group": "0_order@1"
        },
        {
          "command": "sbatlas.moveTaskDown",
          "when": "view == sbatlasProjectView && viewItem == taskItem",
          "group": "0_order@2"
        },
        {
          "command": "sbatlas.moveTaskToModule",
          "when": "view == sbatlasProjectView && viewItem == taskItem",
          "group": "0_order@3"
        },
        {
          "command": "sbatlas.manageTaskDependencies",
          "when": "view == sbatlasProjectView && viewItem == taskItem",
          "group": "3_deps"
        },
        {
          "command": "sbatlas.export",
          "when": "view == sbatlasProjectView && viewItem == projectRoot",
          "group": "5_export"
        },
        {
          "command": "sbatlas.generateReport",
          "when": "view == sbatlasProjectView && viewItem == projectRoot",
          "group": "4_report"
        }
    ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.123.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
